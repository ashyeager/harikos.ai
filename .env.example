# Canonical origin used for Supabase and GitHub App callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth browser/server configuration. Publishable values are safe for clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Signs short-lived GitHub installation state. Use at least 32 random characters.
HARIKOS_SESSION_SECRET=

# GitHub App user-authorization credentials used only to prove installation ownership.
# Supabase Auth's separate GitHub OAuth App credentials stay in Supabase, not here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App server credentials. Keep the private key server-side and preserve newlines.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# Supabase PostgreSQL connection string for server-only SaaS state.
# Vercel's Supabase integration supplies POSTGRES_URL automatically.
DATABASE_URL=
POSTGRES_URL=

# A service-role key is not used by the current server-side Drizzle boundary.
# If a future server-only feature needs it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe server-only billing. Webhook state is authoritative for Pro access.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Local Stage 1 proof only. Production defaults to disabled.
HARIKOS_ENABLE_LOCAL_DEMO=true
HARIKOS_LOCAL_REPOSITORY=
