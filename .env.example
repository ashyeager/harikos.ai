# Public origin used for OAuth redirects when developing outside localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encrypts the HttpOnly GitHub OAuth session cookie. Use at least 32 random characters.
HARIKOS_SESSION_SECRET=

# GitHub OAuth credentials (the GitHub App can provide these values).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App server credentials. Keep the private key server-side.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Supabase/PostgreSQL connection string for SaaS state.
DATABASE_URL=

# Local Stage 1 proof only. Production defaults to disabled.
HARIKOS_ENABLE_LOCAL_DEMO=true
HARIKOS_LOCAL_REPOSITORY=
