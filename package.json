{
  "name": "harikos-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud project truth for AI coding agents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspaces --if-present",
    "build:phase1": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "demo": "tsx scripts/demo-transition.ts",
    "db:migrate:cloud": "npm run build -w packages/db && node --env-file=.env.local --import tsx scripts/migrate-cloud.ts",
    "dev:web": "node scripts/dev-web.mjs",
    "lint": "eslint . --max-warnings=0",
    "pretest": "pnpm run build:phase1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "playwright test",
    "verify:cloud:functional": "node --env-file=.env.local --import tsx scripts/verify-cloud-functional.ts",
    "verify:cloud:schema": "node --env-file=.env.local --import tsx scripts/verify-cloud-schema.ts",
    "verify:github-app": "node --env-file=.env.local --import tsx scripts/verify-github-app.ts",
    "dev": "npm run dev --workspace=apps/web"
  },
  "devDependencies": {
    "@harikos/cli": "workspace:*",
    "@harikos/core": "workspace:*",
    "@harikos/db": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@rolldown/binding-wasm32-wasi": "1.2.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  }
}