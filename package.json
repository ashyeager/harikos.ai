{
  "name": "harikos-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud project truth for AI coding agents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/db packages/core packages/cli && npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:phase1": "tsc -b packages/db packages/core packages/cli",
    "clean": "npm run clean --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "node scripts/dev-web.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "playwright test",
    "pretest": "npm run build:phase1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@harikos/core": "workspace:*",
    "@harikos/db": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@rolldown/binding-wasm32-wasi": "1.2.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
